# Copy to .env and fill in your local MySQL credentials.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/astralsync"

# Optional LLM reading synthesis (PRD §5). When enabled, a single AI reading
# can be generated once per chart snapshot and is stored permanently. The
# same hook powers the AI transit reading and the daily/weekly/monthly
# forecasts (Phase 3e), each generated once per period and stored until
# discarded. The defaults below target OpenAI — just paste your API key.
# The feature stays disabled until the key is set.
# "api" works with any OpenAI-compatible endpoint; "ollama" uses a local
# Ollama server (READING_LLM_BASE_URL defaults to http://localhost:11434);
# "anthropic" uses the Anthropic Messages API directly (READING_LLM_BASE_URL
# defaults to https://api.anthropic.com — suggested model: claude-opus-5).
# Requests are capped at 1200 completion tokens (sent as `max_tokens` for
# broad provider compatibility; models that require the newer
# `max_completion_tokens` spelling or a fixed temperature are adapted to
# automatically on retry). Note: with an external provider, the name
# letter-value derivations are part of the prompt sent to it.
READING_LLM=api
READING_LLM_MODEL=gpt-4o-mini
READING_LLM_BASE_URL=https://api.openai.com
READING_LLM_API_KEY=

# Optional generation knobs (defaults shown). The timeout is the wall-clock
# budget per call, including automatic retries on 408/429/5xx; max-tokens
# caps a runaway completion (readings) and chat answers separately.
#READING_LLM_TIMEOUT_MS=60000
#READING_LLM_MAX_TOKENS=1200
#READING_LLM_CHAT_MAX_TOKENS=600
#READING_LLM_TEMPERATURE=0.7
