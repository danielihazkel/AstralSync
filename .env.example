# Copy to .env and fill in your local MySQL credentials.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/astralsync"

# Optional LLM reading synthesis (PRD §5). When enabled, a single AI reading
# can be generated once per chart snapshot and is stored permanently. The
# defaults below target OpenAI — just paste your API key. The feature stays
# disabled until the key is set.
# "api" works with any OpenAI-compatible endpoint; "ollama" uses a local
# Ollama server (READING_LLM_BASE_URL defaults to http://localhost:11434).
# Requests are capped at 1200 completion tokens (sent as `max_tokens` for
# broad provider compatibility). Note: with an external provider, the name
# letter-value derivations are part of the prompt sent to it.
READING_LLM=api
READING_LLM_MODEL=gpt-4o-mini
READING_LLM_BASE_URL=https://api.openai.com
READING_LLM_API_KEY=
