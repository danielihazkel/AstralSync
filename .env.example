# Copy to .env and fill in your local MySQL credentials.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/astralsync"

# Optional LLM reading synthesis (PRD §5) — OFF by default. When enabled, a
# single AI reading can be generated once per chart snapshot and is stored
# permanently. "ollama" uses a local Ollama server; "api" any
# OpenAI-compatible endpoint (READING_LLM_BASE_URL + READING_LLM_API_KEY
# required).
# READING_LLM=off
# READING_LLM_MODEL=llama3.1
# READING_LLM_BASE_URL=http://localhost:11434
# READING_LLM_API_KEY=
