// AstralSync data model (PRD §6). Snapshots are write-once: editing birth
// data creates a new snapshot version, never an UPDATE.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum NameScript {
  latin
  hebrew
  other
}

enum TimeCertainty {
  exact
  approx
  unknown
}

enum HouseSystem {
  placidus
  whole_sign
  equal
}

enum NumeroSystem {
  pythagorean
  gematria
}

enum ReadingGenerator {
  template
  llm
  hebrew_llm
}

enum ForecastMode {
  western
  hebrew
}

enum ForecastKind {
  day
  week
  month
}

// Canonical union lives in lib/journalMeta.ts (client-safe); keep in sync.
enum JournalMood {
  very_low
  low
  neutral
  high
  very_high
}

// Imported once from GeoNames cities15000 (scripts/import-geonames.mts).
model GeoCity {
  geonameId   Int       @id @map("geoname_id")
  name        String    @db.VarChar(200)
  asciiName   String    @map("ascii_name") @db.VarChar(200)
  countryCode String    @map("country_code") @db.VarChar(2)
  admin1      String?   @db.VarChar(20)
  lat         Float
  lng         Float
  population  Int
  profiles    Profile[]

  @@index([asciiName])
  @@index([name])
  @@map("geo_city")
}

model Profile {
  id                 Int           @id @default(autoincrement())
  displayName        String        @map("display_name") @db.VarChar(100)
  /// Latin/transliterated name — Pythagorean numerology. See hebrewBirthName.
  fullBirthName      String?       @map("full_birth_name") @db.VarChar(200)
  /// Hebrew name — gematria destiny + the mispar-katan Mazal name reading.
  /// Both names may coexist; either may be null.
  hebrewBirthName    String?       @map("hebrew_birth_name") @db.VarChar(200)
  /// Vestigial since the two-field split: the UI only writes "latin" now;
  /// "hebrew"/"other" remain for legacy rows and old exports.
  nameScript         NameScript    @default(latin) @map("name_script")
  birthDate          DateTime      @map("birth_date") @db.Date
  /// Local wall-clock birth time as "HH:MM"; null when unknown.
  birthTime          String?       @map("birth_time") @db.VarChar(5)
  timeCertainty      TimeCertainty @default(exact) @map("time_certainty")
  birthCityGeonameId Int?          @map("birth_city_geoname_id")
  birthCity          GeoCity?      @relation(fields: [birthCityGeonameId], references: [geonameId])
  birthLat           Float         @map("birth_lat")
  birthLng           Float         @map("birth_lng")
  tzIana             String        @map("tz_iana") @db.VarChar(64)
  utcOffsetMinutes   Int           @map("utc_offset_minutes")
  offsetOverridden   Boolean       @default(false) @map("offset_overridden")
  /// At most one profile is primary ("me"): it leads the Today strip and is
  /// preselected wherever a chart is picked. Enforced in lib/snapshots.ts
  /// (clear-then-set in one transaction), not by a DB constraint.
  isPrimary          Boolean       @default(false) @map("is_primary")
  /// Soft delete: set when the user deletes the profile, cleared on restore
  /// from the Trash. The Prisma client (lib/db.ts) hides trashed rows from
  /// every ordinary read; a hard delete (purge) still cascades.
  deletedAt          DateTime?     @map("deleted_at")
  createdAt          DateTime      @default(now()) @map("created_at")

  astroSnapshots  AstroSnapshot[]
  numeroSnapshots NumeroSnapshot[]
  hebrewSnapshots HebrewSnapshot[]
  forecasts       Forecast[]
  journalEntries  JournalEntry[]

  synastryReadingsAsA SynastryReading[] @relation("synastryA")
  synastryReadingsAsB SynastryReading[] @relation("synastryB")

  @@map("profile")
}

// Write-once. New birth data or house system → new version row.
model AstroSnapshot {
  id             Int         @id @default(autoincrement())
  profileId      Int         @map("profile_id")
  profile        Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  version        Int
  houseSystem    HouseSystem @map("house_system")
  isSolarChart   Boolean     @map("is_solar_chart")
  sunSign        String      @map("sun_sign") @db.VarChar(12)
  moonSign       String      @map("moon_sign") @db.VarChar(12)
  ascendant      String?     @db.VarChar(12)
  placementsJson Json        @map("placements_json")
  aspectsJson    Json        @map("aspects_json")
  engine         String      @db.VarChar(32)
  engineVersion  String      @map("engine_version") @db.VarChar(16)
  contentVersion String      @map("content_version") @db.VarChar(16)
  /// What changed versus the previous version ("House system: Placidus →
  /// Whole Sign"), derived at edit time; null for v1 and pre-feature rows.
  note           String?     @db.VarChar(400)
  createdAt      DateTime    @default(now()) @map("created_at")
  readings       Reading[]
  readingArchive ReadingArchive[]

  @@unique([profileId, version])
  @@map("astro_snapshot")
}

// Write-once, same versioning rule as astro_snapshot.
model NumeroSnapshot {
  id             Int          @id @default(autoincrement())
  profileId      Int          @map("profile_id")
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  version        Int
  system         NumeroSystem
  lifePathInt    Int          @map("life_path_int")
  /// Null when no birth name was provided (names are optional, PRD §4.6).
  destinyInt     Int?         @map("destiny_int")
  soulUrgeInt    Int?         @map("soul_urge_int")
  isMasterLp     Boolean      @map("is_master_lp")
  derivationJson Json         @map("derivation_json")
  createdAt      DateTime     @default(now()) @map("created_at")
  readings       Reading[]

  @@unique([profileId, version])
  @@map("numero_snapshot")
}

// Write-once, same versioning rule as astro_snapshot. Third snapshot of a
// version (Phase 2b); pre-feature versions may lack a row — the latest
// version is lazily backfilled on view, historical versions never are.
model HebrewSnapshot {
  id              Int      @id @default(autoincrement())
  profileId       Int      @map("profile_id")
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  version         Int
  /// Effective (sunset-adjusted) Hebrew date, transliterated, e.g. "15 Cheshvan 5769".
  hebrewDate      String   @map("hebrew_date") @db.VarChar(40)
  /// Content key; Adar I/II collapsed to "adar".
  monthKey        String   @map("month_key") @db.VarChar(12)
  dayPlanet       String   @map("day_planet") @db.VarChar(12)
  /// Null for unknown birth time or the polar no-sunset fallback.
  hourPlanet      String?  @map("hour_planet") @db.VarChar(12)
  dateGematriaInt Int      @map("date_gematria_int")
  /// Full MazalChart (hebrew-core schemaVersion 1).
  mazalJson       Json     @map("mazal_json")
  /// { dateGematria, katanName } — katanName null unless the profile has a Hebrew name.
  gematriaJson    Json     @map("gematria_json")
  engine          String   @db.VarChar(32)
  engineVersion   String   @map("engine_version") @db.VarChar(16)
  contentVersion  String   @map("content_version") @db.VarChar(16)
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([profileId, version])
  @@map("hebrew_snapshot")
}

// Optional synthesis, generated once per snapshot pair and stored forever.
model Reading {
  id               Int              @id @default(autoincrement())
  astroSnapshotId  Int              @map("astro_snapshot_id")
  astroSnapshot    AstroSnapshot    @relation(fields: [astroSnapshotId], references: [id], onDelete: Cascade)
  numeroSnapshotId Int?             @map("numero_snapshot_id")
  numeroSnapshot   NumeroSnapshot?  @relation(fields: [numeroSnapshotId], references: [id], onDelete: Cascade)
  bodyMd           String           @map("body_md") @db.Text
  generator        ReadingGenerator
  modelName        String?          @map("model_name") @db.VarChar(64)
  /// Content library version the generation prompt was built from.
  contentVersion   String?          @map("content_version") @db.VarChar(16)
  createdAt        DateTime         @default(now()) @map("created_at")

  // "Generated once": one reading per generator per snapshot pair. The astro
  // snapshot id alone identifies the pair (both snapshots share
  // profileId+version); keying on the nullable numero FK would let MySQL
  // admit duplicate rows through repeated NULLs.
  @@unique([astroSnapshotId, generator])
  @@map("reading")
}

// A discarded AI reading, kept so "Discard" is undoable: the Reading row
// (and its unique slot) is gone, the text lives here until restored from the
// Trash or purged. Restoring recreates the Reading — 409 if the slot has
// been regenerated meanwhile.
model ReadingArchive {
  id               Int              @id @default(autoincrement())
  astroSnapshotId  Int              @map("astro_snapshot_id")
  astroSnapshot    AstroSnapshot    @relation(fields: [astroSnapshotId], references: [id], onDelete: Cascade)
  numeroSnapshotId Int?             @map("numero_snapshot_id")
  bodyMd           String           @map("body_md") @db.Text
  generator        ReadingGenerator
  modelName        String?          @map("model_name") @db.VarChar(64)
  contentVersion   String?          @map("content_version") @db.VarChar(16)
  /// The original Reading.createdAt.
  createdAt        DateTime         @map("created_at")
  discardedAt      DateTime         @default(now()) @map("discarded_at")

  @@index([astroSnapshotId])
  @@map("reading_archive")
}

// AI period forecasts: manual generate, cached per profile+mode+kind+period.
// NOT write-once — discard frees the slot for regeneration, like Reading.
// The western daily forecast doubles as the Transits-tab AI reading.
/// AI synastry/composite reading: one cached slot per profile pair, with
/// Forecast semantics (discardable; versions are staleness flags) rather
/// than the write-once Reading semantics.
model SynastryReading {
  id         Int     @id @default(autoincrement())
  /// Ordered pair: profileAId < profileBId, so (a,b) and (b,a) share the slot.
  profileAId Int     @map("profile_a_id")
  profileA   Profile @relation("synastryA", fields: [profileAId], references: [id], onDelete: Cascade)
  profileBId Int     @map("profile_b_id")
  profileB   Profile @relation("synastryB", fields: [profileBId], references: [id], onDelete: Cascade)
  /// Snapshot versions generated against — staleness flags, NOT keys
  /// (the Forecast.natalVersion stance).
  aVersion       Int      @map("a_version")
  bVersion       Int      @map("b_version")
  bodyMd         String   @map("body_md") @db.Text
  modelName      String?  @map("model_name") @db.VarChar(64)
  /// Content library version the generation prompt was built from.
  contentVersion String?  @map("content_version") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([profileAId, profileBId])
  @@map("synastry_reading")
}

// User journal notes pinned to a civil date. Intentionally NOT write-once —
// notes are the user's own words, freely editable and deletable (the
// Forecast "discardable" stance, not the snapshot one). skyJson snapshots
// the transits active when the entry was saved (EntrySky in lib/journal.ts)
// so an entry keeps "what was in the sky" even across engine upgrades; the
// browsable sky view still recomputes via /api/transits/[id]?at= (PRD §9).
model JournalEntry {
  id        Int      @id @default(autoincrement())
  profileId Int      @map("profile_id")
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Civil local date the note is about (not when it was written).
  entryDate DateTime @map("entry_date") @db.Date
  bodyMd    String   @map("body_md") @db.Text
  /// Optional 5-point mood for the day the note is about.
  mood      JournalMood?
  /// Normalized free-form tags as a JSON string array (MySQL has no scalar
  /// lists); null = no tags, mirroring skyJson's null stance.
  tagsJson  Json?    @map("tags_json")
  /// EntrySky JSON captured at create (recomputed only when entryDate is
  /// edited); null for pre-feature entries or when no snapshot existed.
  skyJson   Json?    @map("sky_json")
  /// Soft delete, same contract as Profile.deletedAt (hidden by lib/db.ts,
  /// restorable from the Trash).
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([profileId, entryDate])
  @@map("journal_entry")
}

model Forecast {
  id        Int          @id @default(autoincrement())
  profileId Int          @map("profile_id")
  profile   Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mode      ForecastMode
  kind      ForecastKind
  /// Civil local date the period starts (day: the date; week: its Sunday;
  /// month: civil-month 1st (western) / Hebrew-month day 1 (hebrew)).
  periodStart    DateTime @map("period_start") @db.Date
  /// Astro snapshot version generated against — staleness flag, NOT a key.
  natalVersion   Int      @map("natal_version")
  bodyMd         String   @map("body_md") @db.Text
  modelName      String?  @map("model_name") @db.VarChar(64)
  /// Content library version the generation prompt was built from.
  contentVersion String?  @map("content_version") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([profileId, mode, kind, periodStart])
  @@map("forecast")
}
